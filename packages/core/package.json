{
  "name": "@sepalo/core",
  "version": "0.1.0",
  "description": "CBI XML generation library — types, validators, and document builder for CBIBdyPaymentRequest.00.04.01",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayoubl96/sepalo.git",
    "directory": "packages/core"
  },
  "homepage": "https://sepalo.it/docs",
  "keywords": [
    "cbi",
    "xml",
    "payment",
    "sepa",
    "bonifico",
    "italia",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "embed:xsd": "node scripts/embed-xsd.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "fast-xml-parser": "^5.7.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "xmllint-wasm": "^5.2.0"
  },
  "peerDependenciesMeta": {
    "xmllint-wasm": {
      "optional": true
    }
  }
}
